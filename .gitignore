# Node.js dependencies
/node_modules/

# Log files
*.log

# Environment variable files
.env

# Build output
/dist/
/build/

# Mac OS generated files
.DS_Store

# Windows thumbnail cache
Thumbs.db

# Frontend build artifacts (if any)
/frontend/dist/
/frontend/build/

# IDE or editor files
